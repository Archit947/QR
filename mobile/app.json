{
  "expo": {
    "name": "QRTrainingMobile",
    "slug": "qr-training-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false
    },
    "android": {},
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-barcode-scanner",
      "expo-secure-store"
    ]
  }
}
